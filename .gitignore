# Environnement Python local (817 Mo) : a recreer avec requirements.txt
.venv/
__pycache__/
*.pyc

# IDE
.idea/

# Artefacts de build : regenerables avec build_exe.bat (84 Mo, change a chaque rebuild)
build/
dist/
build.zip

# Archives de sauvegarde : livrables pour cle USB, pas pour le depot
*.zip

# Etat local des essais (le tableau enseignant se remplit a l'usage)
TPs/progres.csv

# Livres du prof : restent en local (droits d'auteur)
cours/livres/*.pdf

# Index BM25 des livres : regenerable en quelques secondes au demarrage
cours/cache_index/

# Tunnel : binaire de 53 Mo (re-telecharge par partager.py) et etat du moment
outils_tunnel/cloudflared.exe
resultats/lien_public.txt
resultats/tunnel.log

# Divers
*.log
.DS_Store
